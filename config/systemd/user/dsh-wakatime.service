[Unit]
Description=Sync DeepSeek Harness activity to WakaTime
After=default.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/dsh-wakatime sync --quiet --category coding
Nice=10
UMask=0077

# 最小权限：整个文件系统只读，仅放行 wakatime 数据目录与本程序状态目录；
# 丢弃全部 capability，限制内核面与 syscall，禁止写 ~/Projects 等位置。
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.wakatime %h/.local/state/dsh-wakatime
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
