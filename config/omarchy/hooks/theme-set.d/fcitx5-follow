#!/usr/bin/env bash
# fcitx5-follow — keep the fcitx5 input panel in sync with the active Omarchy theme.
#
# Location: ~/.config/omarchy/hooks/theme-set.d/fcitx5-follow
# Called by `omarchy theme set <name>` via `omarchy-hook theme-set <snake-case-name>`.
# It receives the snake-cased theme name as $1. Delete this file to disable.
#
# Behaviour:
#   * catppuccin / catppuccin-latte  -> use the hand-tuned upstream Catppuccin themes,
#     wherever they live (pacman: /usr/share, manual install: ~/.local/share).
#   * every other Omarchy theme      -> generate "omarchy-auto" from that theme's colors.toml.
# Only writes inside ~ ($HOME/.local/share/fcitx5, $HOME/.config/fcitx5).

set -uo pipefail

theme="${1:-}"
[ -n "$theme" ] || exit 0

# --- locate the theme's palette (user themes shadow stock ones) ---------------
COLORS=""
for base in "$HOME/.config/omarchy/themes" "$HOME/.local/share/omarchy/themes"; do
  if [ -f "$base/$theme/colors.toml" ]; then
    COLORS="$base/$theme/colors.toml"
    break
  fi
done
[ -n "$COLORS" ] || exit 0

THEMES_DIR="$HOME/.local/share/fcitx5/themes"   # writable: generated themes go here
SYSTEM_THEMES_DIR="/usr/share/fcitx5/themes"    # read-only: pacman-installed themes
CONF="$HOME/.config/fcitx5/conf/classicui.conf"
[ -f "$CONF" ] || exit 0
mkdir -p "$THEMES_DIR"

# Resolve a theme name to the first directory that actually holds it. Installed
# themes can come from either place, so never assume one of them.
theme_dir() {
  for d in "$THEMES_DIR/$1" "$SYSTEM_THEMES_DIR/$1"; do
    if [ -f "$d/theme.conf" ]; then
      printf '%s\n' "$d"
      return 0
    fi
  done
  return 1
}

# --- hand-tuned themes take priority -----------------------------------------
target=""
case "$theme" in
  catppuccin)       want="catppuccin-mocha-blue" ;;
  catppuccin-latte) want="catppuccin-latte-blue" ;;
  *)                want="" ;;
esac
if [ -n "$want" ] && theme_dir "$want" >/dev/null; then
  target="$want"
fi

# --- otherwise generate a theme from the Omarchy palette ---------------------
if [ -z "$target" ]; then
  target=$(python3 - "$COLORS" "$THEMES_DIR" "$SYSTEM_THEMES_DIR" <<'PY'
import os, re, sys

colors_path, themes_dir, system_themes_dir = sys.argv[1], sys.argv[2], sys.argv[3]

vals = {}
with open(colors_path, encoding="utf-8") as fh:
    for line in fh:
        m = re.match(r'\s*([A-Za-z0-9_]+)\s*=\s*"?(#[0-9a-fA-F]{6})"?\s*$', line)
        if m:
            vals[m.group(1)] = m.group(2).lower()

bg = vals.get("background")
if not bg:
    sys.exit(0)
fg = vals.get("foreground", "#ffffff")
accent = vals.get("accent", fg)

rgb = lambda h: tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))
hx = lambda t: "#%02x%02x%02x" % t


def blend(a, b, t):
    ra, rb = rgb(a), rgb(b)
    return hx(tuple(round(ra[i] + (rb[i] - ra[i]) * t) for i in range(3)))


surface = blend(bg, fg, 0.10)      # panel sits slightly above the background
on_accent = bg                     # text drawn on top of the accent colour
r, g, b = rgb(bg)
is_light = (0.2126 * r + 0.7152 * g + 0.0722 * b) > 127.5

name = "omarchy-auto"
d = os.path.join(themes_dir, name)
os.makedirs(d, exist_ok=True)

with open(os.path.join(d, "theme.conf"), "w", encoding="utf-8") as fh:
    fh.write(f"""# vim: ft=dosini
# Generated by fcitx5-follow from {os.path.basename(os.path.dirname(colors_path))}/colors.toml
# Do not edit by hand: it is regenerated on every Omarchy theme change.
[Metadata]
Name=Omarchy Auto
Version=1.0
Author=fcitx5-follow
Description=Generated from the active Omarchy theme
ScaleWithDPI=True

[InputPanel]
Font=Sans 13
Spacing=3

NormalColor={fg}
HighlightCandidateColor={on_accent}
HighlightColor={accent}
HighlightBackgroundColor={surface}

[InputPanel/TextMargin]
Left=18
Right=18
Top=8
Bottom=8

[InputPanel/Background]
Color={surface}
Image=panel.svg

[InputPanel/Background/Margin]
Left=10
Right=10
Top=10
Bottom=10

[InputPanel/Highlight]
Color={accent}
Image=highlight.svg

[InputPanel/Highlight/Margin]
Left=18
Right=18
Top=8
Bottom=8

[Menu]
Font=Sans 10
NormalColor={fg}
Spacing=3

[Menu/Background]
Color={surface}

[Menu/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/ContentMargin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/Highlight]
Color={accent}

[Menu/Highlight/Margin]
Left=10
Right=10
Top=5
Bottom=5

[Menu/Separator]
Color={bg}

[Menu/CheckBox]
Image=radio.png

[Menu/SubMenu]
Image=arrow.png

[Menu/TextMargin]
Left=5
Right=5
Top=5
Bottom=5
""")

# Rounded-corner images, tinted to this palette.
svg = ('<svg width="39" height="39" version="1.1" xmlns="http://www.w3.org/2000/svg">\n'
       '  <rect width="39" height="39" rx="8" fill="%s"/>\n</svg>\n')
for fname, colour in (("panel.svg", surface), ("highlight.svg", accent)):
    with open(os.path.join(d, fname), "w", encoding="utf-8") as fh:
        fh.write(svg % colour)

# radio/arrow glyphs are colour-neutral, but upstream ships light and dark
# variants: borrow the one that stays visible on our background. Look in the
# user dir first, then the system dir, since the Catppuccin set may be in either.
glyph_name = "catppuccin-latte-blue" if is_light else "catppuccin-mocha-blue"
glyph_src = ""
for base in (themes_dir, system_themes_dir):
    cand = os.path.join(base, glyph_name)
    if os.path.isdir(cand):
        glyph_src = cand
        break
for glyph in ("radio.png", "arrow.png"):
    if not glyph_src:
        break
    src, dst = os.path.join(glyph_src, glyph), os.path.join(d, glyph)
    if os.path.exists(src):
        with open(src, "rb") as a, open(dst, "wb") as b:
            b.write(a.read())

print(name)
PY
)
fi

[ -n "$target" ] || exit 0
theme_dir "$target" >/dev/null || exit 0

# --- point fcitx5 at it (only the two Theme lines are rewritten) -------------
if grep -q '^Theme=' "$CONF"; then
  sed -i "s|^Theme=.*|Theme=$target|" "$CONF"
else
  printf 'Theme=%s\n' "$target" >>"$CONF"
fi
if grep -q '^DarkTheme=' "$CONF"; then
  sed -i "s|^DarkTheme=.*|DarkTheme=$target|" "$CONF"
else
  printf 'DarkTheme=%s\n' "$target" >>"$CONF"
fi

# --- reload the panel; Omarchy starts fcitx5 through uwsm-app ----------------
if systemctl --user cat app-org.fcitx.Fcitx5@autostart.service >/dev/null 2>&1; then
  systemctl --user restart app-org.fcitx.Fcitx5@autostart.service >/dev/null 2>&1 || true
else
  fcitx5 -r -d >/dev/null 2>&1 || true
fi

exit 0
